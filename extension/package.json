{
  "name": "apus-affinis",
  "displayName": "Apus affinis",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "miguelacaceresr",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1b1a1f",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/miguelacaceresrios/apus-affinis"
  },
  "bugs": {
    "url": "https://github.com/miguelacaceresrios/apus-affinis/issues"
  },
  "homepage": "https://github.com/miguelacaceresrios/apus-affinis#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "apus",
    "git",
    "auto commit",
    "autocommit",
    "push",
    "commit",
    "sync",
    "watcher",
    "backup"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%untrustedWorkspaces%",
      "restrictedConfigurations": [
        "apus.autoStart"
      ]
    }
  },
  "contributes": {
    "icons": {
      "apus-logo": {
        "description": "%icons.logo%",
        "default": {
          "fontPath": "images/apus-icons.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apus",
          "title": "Apus",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "apus": [
        {
          "id": "apus.repos",
          "name": "%views.repos%",
          "icon": "images/activity.svg",
          "contextualTitle": "Apus"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "apus.repos",
        "when": "apus.binaryMissing",
        "contents": "%viewsWelcome.binaryMissing%"
      },
      {
        "view": "apus.repos",
        "when": "!apus.binaryMissing",
        "contents": "%viewsWelcome.noRepos%"
      }
    ],
    "walkthroughs": [
      {
        "id": "apus.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "connect",
            "title": "%walkthrough.connect.title%",
            "description": "%walkthrough.connect.description%",
            "media": {
              "svg": "media/walkthrough/connect.svg",
              "altText": "%walkthrough.connect.alt%"
            },
            "completionEvents": [
              "onContext:apus.binaryFound"
            ]
          },
          {
            "id": "watch",
            "title": "%walkthrough.watch.title%",
            "description": "%walkthrough.watch.description%",
            "media": {
              "svg": "media/walkthrough/watch.svg",
              "altText": "%walkthrough.watch.alt%"
            },
            "completionEvents": [
              "onContext:apus.watchingAny"
            ]
          },
          {
            "id": "status",
            "title": "%walkthrough.status.title%",
            "description": "%walkthrough.status.description%",
            "media": {
              "svg": "media/walkthrough/status.svg",
              "altText": "%walkthrough.status.alt%"
            },
            "completionEvents": [
              "onCommand:apus.menu"
            ]
          },
          {
            "id": "rules",
            "title": "%walkthrough.rules.title%",
            "description": "%walkthrough.rules.description%",
            "media": {
              "svg": "media/walkthrough/rules.svg",
              "altText": "%walkthrough.rules.alt%"
            },
            "completionEvents": [
              "onCommand:apus.openSettings"
            ]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "apus.menu",
        "title": "%commands.menu%",
        "category": "Apus",
        "icon": "$(list-selection)"
      },
      {
        "command": "apus.toggleWatch",
        "title": "%commands.toggleWatch%",
        "category": "Apus",
        "icon": "$(eye)"
      },
      {
        "command": "apus.watch",
        "title": "%commands.watch%",
        "category": "Apus",
        "icon": "$(eye)"
      },
      {
        "command": "apus.pause",
        "title": "%commands.pause%",
        "category": "Apus",
        "icon": "$(eye-closed)"
      },
      {
        "command": "apus.pushNow",
        "title": "%commands.pushNow%",
        "category": "Apus",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "apus.showLog",
        "title": "%commands.showLog%",
        "category": "Apus",
        "icon": "$(history)"
      },
      {
        "command": "apus.openSettings",
        "title": "%commands.openSettings%",
        "category": "Apus",
        "icon": "$(settings-gear)"
      },
      {
        "command": "apus.selectBinary",
        "title": "%commands.selectBinary%",
        "category": "Apus"
      },
      {
        "command": "apus.fixBinary",
        "title": "%commands.fixBinary%",
        "category": "Apus",
        "icon": "$(tools)"
      },
      {
        "command": "apus.downloadApus",
        "title": "%commands.downloadApus%",
        "category": "Apus",
        "icon": "$(cloud-download)"
      },
      {
        "command": "apus.getStarted",
        "title": "%commands.getStarted%",
        "category": "Apus",
        "icon": "$(book)"
      },
      {
        "command": "apus.showOutput",
        "title": "%commands.showOutput%",
        "category": "Apus",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "apus.watch",
          "when": "false"
        },
        {
          "command": "apus.pause",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "apus.openSettings",
          "when": "view == apus.repos",
          "group": "navigation@1"
        },
        {
          "command": "apus.showOutput",
          "when": "view == apus.repos",
          "group": "navigation@2"
        },
        {
          "command": "apus.getStarted",
          "when": "view == apus.repos",
          "group": "more@1"
        },
        {
          "command": "apus.selectBinary",
          "when": "view == apus.repos",
          "group": "more@2"
        }
      ],
      "view/item/context": [
        {
          "command": "apus.watch",
          "when": "view == apus.repos && viewItem == apus.repo.paused",
          "group": "inline@1"
        },
        {
          "command": "apus.pause",
          "when": "view == apus.repos && viewItem == apus.repo.watching",
          "group": "inline@1"
        },
        {
          "command": "apus.pushNow",
          "when": "view == apus.repos",
          "group": "inline@2"
        },
        {
          "command": "apus.showLog",
          "when": "view == apus.repos",
          "group": "apus@1"
        }
      ]
    },
    "configuration": {
      "title": "Apus",
      "properties": {
        "apus.autoStart": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%config.autoStart%"
        },
        "apus.watchInterval": {
          "type": "number",
          "default": 120,
          "minimum": 5,
          "scope": "resource",
          "markdownDescription": "%config.watchInterval%"
        },
        "apus.minInterval": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "scope": "resource",
          "markdownDescription": "%config.minInterval%"
        },
        "apus.ignorePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.ignorePatterns%"
        },
        "apus.messageTemplate": {
          "type": "string",
          "default": "chore: auto-commit {date}",
          "scope": "resource",
          "markdownDescription": "%config.messageTemplate%"
        },
        "apus.notifications": {
          "type": "string",
          "enum": [
            "all",
            "errors",
            "off"
          ],
          "enumDescriptions": [
            "%config.notifications.all%",
            "%config.notifications.errors%",
            "%config.notifications.off%"
          ],
          "default": "all",
          "scope": "window",
          "markdownDescription": "%config.notifications%"
        },
        "apus.logSize": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 200,
          "scope": "resource",
          "markdownDescription": "%config.logSize%"
        },
        "apus.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.path%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "check": "tsc --noEmit",
    "compile": "npm run check && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run check && node esbuild.mjs --production",
    "test": "tsc -p tsconfig.test.json && node --test \"out/test/**/*.test.js\"",
    "l10n": "l10n-dev export --outDir ./l10n ./src",
    "icons": "node scripts/icons.mjs",
    "vsix": "vsce package --no-dependencies --out apus-affinis.vsix",
    "install-ext": "npm run vsix && code --install-extension apus-affinis.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/vscode": "~1.90.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "svg2ttf": "^6.1.0",
    "ttf2woff": "^3.0.0",
    "typescript": "~5.9"
  }
}
